# Copy this file to .env and fill in your own values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS / Linux)
# Never commit the real .env file — it holds secrets.

# Required: bot token from https://discord.com/developers/applications
# (Applications → your app → Bot → Token). Keep it secret.
DISCORD_TOKEN=your-bot-token-here

# Required: Application ID of the same Discord application
# (General Information → Application ID). Used to register slash commands.
CLIENT_ID=your-application-client-id-here

# Optional: for instant guild-scoped command updates during development.
# If omitted, commands are registered globally (can take up to 1 hour to appear).
GUILD_ID=

# Note: Churan has no HTTP server and needs no PORT variable.
# On Render, set the same three variables in the service Environment tab.
